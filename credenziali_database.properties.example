# Credenziali di accesso al server MySQL usate dal backend "mysql".
# Copiare come "credenziali_database.properties" accanto a Rubrica.jar e
# sostituire i valori con quelli del proprio sistema MySQL durante
# l'installazione (vedi schema_database.sql per la creazione del database).
#
# Mappatura con i dati richiesti dalle specifiche:
#   db.host     -> ip-server-mysql
#   db.port     -> porta
#   db.user     -> username
#   db.password -> password
#   db.database -> nome del database (deve coincidere con schema_database.sql)

db.host=localhost
db.port=3306
db.database=rubrica
db.user=root
db.password=
